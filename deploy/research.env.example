# Candidate only. Do not apply to production before acceptance and authorization.
SMARTINIS_RESEARCH_ENABLED=1
RESEARCH_ALLOWED_OWNERS=replace-with-existing-openwebui-user-id
RESEARCH_MODEL=replace-with-existing-local-model-tag
RESEARCH_LEDGER=/absolute/path/to/existing/ingestion/state.json
RESEARCH_SEARCH_URL=http://127.0.0.1:8888/search
# General source discovery with optional explicit host restriction.
RESEARCH_SEARCH_ENGINES=brave,yahoo,wikipedia
RESEARCH_RESTRICT_HOSTS=0
RESEARCH_SOURCE_HOSTS=learn.microsoft.com,docs.aws.amazon.com,cloud.google.com,sre.google,owasp.org
